words = ["create", "creates", "creating"]

print("{:<12} {:<8} {:<20} {:<10} {:<12}".format(
    "Word", "Suffix", "Grammar", "Root", "Normalized"))

for word in words:

    if word == "create":
        suffix = "-"
        grammar = "Base Form"
        root = "create"

    elif word.endswith("s"):
        suffix = "s"
        grammar = "3rd Person Singular"
        root = "create"

    elif word.endswith("ing"):
        suffix = "ing"
        grammar = "Present Participle"
        root = "create"

    print("{:<12} {:<8} {:<20} {:<10} {:<12}".format(
        word, suffix, grammar, root, root))